# Supabase Postgres — pooled (runtime) + direct (migrations)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase data access — SERVER ONLY (service-role key, bypasses RLS, never
# exposed to the browser). Used by lib/supabase.ts for all reads/writes.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY=

# Supabase Auth — PUBLIC (safe in the browser). Used by @supabase/ssr for
# Google OAuth + email magic link. The anon key is an RLS-scoped identity key,
# NOT the service key above — it grants no data access in this app.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenRouter — the AI layer (OpenAI-compatible). Server only.
OPENROUTER_API_KEY=

# Gemini — DEPRECATED (AI layer swapped to OpenRouter). Kept for reference.
GEMINI_API_KEY=
