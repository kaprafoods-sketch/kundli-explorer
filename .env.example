# Supabase Postgres — pooled (runtime) + direct (migrations)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[YOUR_DB_PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Supabase REST client — used by the runtime data layer (chart creation / "signup",
# profiles, GRAHA AI). SUPABASE_SERVICE_KEY is REQUIRED for server-side writes.
# SUPABASE_URL is optional: if omitted it is derived from the project ref in
# DATABASE_URL/DIRECT_URL. Without SUPABASE_SERVICE_KEY, chart creation fails.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_KEY=

# Gemini — get from aistudio.google.com/app/apikey
GEMINI_API_KEY=
