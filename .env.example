# Supabase Postgres — pooled (runtime) + direct (migrations)
DATABASE_URL=<redacted>
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

# Gemini — get from aistudio.google.com/app/apikey
GEMINI_API_KEY=<redacted>

# geo-tz — data-dir override (dev only: under Turbopack dev `__dirname` resolves to a bogus path and chart renders crash with ENOENT; see README Troubleshooting)
# GEO_TZ_DATA_PATH="$PWD/node_modules/geo-tz/data"
